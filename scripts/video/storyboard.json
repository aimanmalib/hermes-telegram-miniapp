{
  "canvas": {
    "width": 1080,
    "height": 1920,
    "fps": 30
  },
  "phone": {
    "screen_width": 760,
    "bezel": 20,
    "radius": 72,
    "bottom_margin": 28
  },
  "record": {
    "viewport_scale": 2,
    "theme": "dark",
    "lang": "en"
  },
  "fade_sec": 0.3,
  "forbid_on_screen": [
    "/home/",
    "/Users/",
    "127.0.0.1"
  ],
  "title": "Hermes Telegram Mini App",
  "repo": "github.com/aimanmalib/hermes-telegram-miniapp",
  "shots": [
    {
      "id": "title",
      "kind": "card",
      "duration": 2.5,
      "lines": [
        "Hermes Telegram Mini App",
        "Run your Hermes agent from Telegram"
      ]
    },
    {
      "id": "ask",
      "kind": "app",
      "duration": 22,
      "needs_live": true,
      "caption": "Ask from your phone. Hermes answers in your Telegram chat.",
      "ask": {
        "question": "Three-bullet checklist before I ship a release tonight? No commands.",
        "type_delay_ms": 20,
        "hold_queued_sec": 1.6,
        "max_wait_sec": 240,
        "lead_in_sec": 3,
        "hold_delivered_sec": 1.0,
        "skip_chip": "Skipped: the wait for Hermes's next tick",
        "delivered_title": "Delivered to your Telegram chat",
        "delivered_note": "Hermes's real reply, as Telegram shows it",
        "hold_reply_sec": 5.0
      }
    },
    {
      "id": "status",
      "kind": "app",
      "duration": 8,
      "needs_live": true,
      "caption": "Live from a real Hermes v{hermes_version}: host, sessions and cron."
    },
    {
      "id": "cron",
      "kind": "app",
      "duration": 10,
      "caption": "Run, pause and edit cron jobs. Failed runs are flagged."
    },
    {
      "id": "sessions",
      "kind": "app",
      "duration": 7,
      "caption": "Read what your agent did, step by step."
    },
    {
      "id": "brain",
      "kind": "app",
      "duration": 8,
      "caption": "Browse skills. English and Malay built in.",
      "filter": "review"
    },
    {
      "id": "security",
      "kind": "card",
      "duration": 5.5,
      "lines": [
        "Built to be safe on a phone",
        "HMAC + Ed25519 verified Telegram login",
        "Fail-closed admin list",
        "Your proxy forwards only /api/plugins/telegram-app/*",
        "Contract-tested against real Hermes in CI"
      ]
    },
    {
      "id": "close",
      "kind": "card",
      "duration": 4.5,
      "lines": [
        "github.com/aimanmalib/hermes-telegram-miniapp",
        "Submitted to the Hermes plugin catalog as telegram-app",
        "MIT licensed"
      ]
    }
  ],
  "audio": {
    "lufs": -14,
    "true_peak": -1.5,
    "sample_rate": 48000,
    "bed": {
      "chord_sec": 4,
      "gain": 0.16,
      "attack_sec": 1.2,
      "fade_in_sec": 1.5,
      "fade_out_sec": 3,
      "chords": [
        [
          220.0,
          277.18,
          329.63,
          440.0
        ],
        [
          196.0,
          246.94,
          293.66,
          392.0
        ],
        [
          174.61,
          220.0,
          261.63,
          349.23
        ],
        [
          196.0,
          246.94,
          329.63,
          392.0
        ]
      ],
      "bass_gain": 0.1,
      "shimmer_gain": 0.025
    },
    "cues": {
      "tap": {
        "freq": 1250,
        "ms": 45,
        "gain": 0.22
      },
      "chime": {
        "freqs": [
          880.0,
          1318.51
        ],
        "ms": 700,
        "gain": 0.18
      }
    }
  },
  "audio_note": "Generated music bed and UI cues (scripts/video/audio.py); no third-party audio."
}
